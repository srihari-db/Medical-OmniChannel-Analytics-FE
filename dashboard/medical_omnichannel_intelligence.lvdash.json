{
  "datasets": [
    {
      "name": "kpis",
      "displayName": "Headline KPIs",
      "queryLines": [
        "SELECT (SELECT COUNT(*) FROM `_sa701`.moa.gold_hcp_360) AS total_hcps, ",
        "(SELECT COUNT(*) FROM `_sa701`.moa.gold_hcp_priority WHERE priority_tier='High') AS priority_high, ",
        "(SELECT ROUND(COUNT_IF(days_since_last_msl<=90)/COUNT(*),3) FROM `_sa701`.moa.gold_hcp_360) AS reach_90d_pct, ",
        "(SELECT COUNT_IF(under_engaged_priority) FROM `_sa701`.moa.gold_hcp_360) AS under_engaged, ",
        "(SELECT COUNT_IF(overdue) FROM `_sa701`.moa.gold_medical_information_requests) AS overdue_inquiries, ",
        "(SELECT ROUND(AVG(response_time_days),1) FROM `_sa701`.moa.gold_medical_information_requests WHERE response_status='Closed') AS avg_response_days"
      ]
    },
    {
      "name": "reach_by_territory",
      "displayName": "Reach by territory",
      "queryLines": [
        "SELECT territory, total_hcps, reach_rate, under_engaged_priority_hcps, ",
        "ROUND(territory_opportunity_score,1) AS opportunity_score ",
        "FROM `_sa701`.moa.gold_territory_opportunity ORDER BY reach_rate ASC"
      ]
    },
    {
      "name": "topic_interest",
      "displayName": "Scientific topic interest",
      "queryLines": [
        "SELECT topic_category, SUM(mentions) AS mentions, COUNT(DISTINCT hcp_id) AS hcps ",
        "FROM `_sa701`.moa.gold_medical_topic_interest GROUP BY topic_category ORDER BY mentions DESC"
      ]
    },
    {
      "name": "inquiry_sla",
      "displayName": "Medical inquiry SLA by product",
      "queryLines": [
        "SELECT product, COUNT(*) AS total_inquiries, COUNT_IF(overdue) AS overdue_inquiries, ",
        "ROUND(COUNT_IF(sla_met)/NULLIF(COUNT_IF(response_status='Closed'),0),3) AS sla_met_pct ",
        "FROM `_sa701`.moa.gold_medical_information_requests GROUP BY product ORDER BY total_inquiries DESC"
      ]
    },
    {
      "name": "priority_dist",
      "displayName": "Priority tier distribution",
      "queryLines": [
        "SELECT priority_tier, COUNT(*) AS hcps FROM `_sa701`.moa.gold_hcp_priority GROUP BY priority_tier"
      ]
    },
    {
      "name": "next_best_queue",
      "displayName": "MSL next-best-engagement queue",
      "queryLines": [
        "SELECT hcp_name, territory, priority_tier, ROUND(msl_priority_score,1) AS msl_priority_score, ",
        "trigger, topic, recommended_date FROM `_sa701`.moa.gold_next_best_engagement ",
        "ORDER BY msl_priority_score DESC LIMIT 25"
      ]
    }
  ],
